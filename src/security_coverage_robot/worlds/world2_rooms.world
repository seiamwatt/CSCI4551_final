<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <!-- ==================== OUTER WALLS (12x12 arena) ==================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== INTERIOR WALLS ==================== -->

    <!-- Horizontal wall splitting north half, with a doorway gap on the right -->
    <model name="wall_inner_h1_left">
      <static>true</static>
      <pose>-2.5 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>7 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_inner_h1_right">
      <static>true</static>
      <pose>4.5 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall in the north-left area, with doorway gap at bottom -->
    <model name="wall_inner_v1_top">
      <static>true</static>
      <pose>-2 4.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 3 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 3 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall in the south half, with doorway gap on the left -->
    <model name="wall_inner_h2_right">
      <static>true</static>
      <pose>2 -2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Short vertical wall creating a small alcove in the SE corner -->
    <model name="wall_inner_v2">
      <static>true</static>
      <pose>3 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 4 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small L-shaped obstacle near center-west -->
    <model name="wall_inner_stub_w">
      <static>true</static>
      <pose>-4 -0.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 2.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.5 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== FLOOR ZONES ==================== -->

    <!-- ORANGE ZONE - large L-shaped south-west area -->
    <model name="zone_orange_a">
      <static>true</static>
      <pose>-3 -4 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6 4 0.01</size></box></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>0.9 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="zone_orange_b">
      <static>true</static>
      <pose>-3 -0.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2 3 0.01</size></box></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>0.9 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- CYAN ZONE - corridor running through the middle -->
    <model name="zone_cyan">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3 4 0.01</size></box></geometry>
          <material><ambient>0.0 0.8 0.8 1</ambient><diffuse>0.0 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- PURPLE ZONE - north-west room -->
    <model name="zone_purple">
      <static>true</static>
      <pose>-4 4 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 4 0.01</size></box></geometry>
          <material><ambient>0.6 0.0 0.8 1</ambient><diffuse>0.6 0.0 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- GREEN ZONE - north-east room -->
    <model name="zone_green">
      <static>true</static>
      <pose>3 4 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6 4 0.01</size></box></geometry>
          <material><ambient>0.0 0.75 0.2 1</ambient><diffuse>0.0 0.75 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- RED ZONE - south-east alcove -->
    <model name="zone_red">
      <static>true</static>
      <pose>4.5 -4 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3 4 0.01</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- BLUE ZONE - east mid-section -->
    <model name="zone_blue">
      <static>true</static>
      <pose>4 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 4 0.01</size></box></geometry>
          <material><ambient>0.1 0.2 0.9 1</ambient><diffuse>0.1 0.2 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
