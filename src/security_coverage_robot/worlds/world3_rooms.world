<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <!-- ==================== OUTER WALLS (12x12 arena) ==================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== INTERIOR WALLS ==================== -->

    <!-- Vertical wall down the center, gap at the top -->
    <model name="wall_inner_v_center">
      <static>true</static>
      <pose>0 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 9 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 9 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall in the west half creating a north-west closet, gap on the right -->
    <model name="wall_inner_h_nw">
      <static>true</static>
      <pose>-4.5 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall in the east half creating upper-right room, gap on the left -->
    <model name="wall_inner_h_ne">
      <static>true</static>
      <pose>4 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Short horizontal wall in the east half creating lower-right alcove, gap on the right -->
    <model name="wall_inner_h_se">
      <static>true</static>
      <pose>1.5 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 0.15 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall on the west side creating a south-west corridor -->
    <model name="wall_inner_v_sw">
      <static>true</static>
      <pose>-3 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 5 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== FLOOR ZONES (green, yellow, blue only) ==================== -->

    <!-- GREEN ZONE - large west-side main area -->
    <model name="zone_green">
      <static>true</static>
      <pose>-3 1 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6 6 0.01</size></box></geometry>
          <material><ambient>0.0 0.8 0.0 1</ambient><diffuse>0.0 0.8 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- YELLOW ZONE - north-west closet -->
    <model name="zone_yellow_nw">
      <static>true</static>
      <pose>-4.5 4.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3 3 0.01</size></box></geometry>
          <material><ambient>0.9 0.9 0.0 1</ambient><diffuse>0.9 0.9 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- BLUE ZONE - east upper room -->
    <model name="zone_blue_ne">
      <static>true</static>
      <pose>3 3.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6 5 0.01</size></box></geometry>
          <material><ambient>0.0 0.0 0.9 1</ambient><diffuse>0.0 0.0 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- YELLOW ZONE - east lower section -->
    <model name="zone_yellow_se">
      <static>true</static>
      <pose>3 -1.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6 3 0.01</size></box></geometry>
          <material><ambient>0.9 0.9 0.0 1</ambient><diffuse>0.9 0.9 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- GREEN ZONE - east bottom alcove -->
    <model name="zone_green_se">
      <static>true</static>
      <pose>3.5 -4.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5 3 0.01</size></box></geometry>
          <material><ambient>0.0 0.8 0.0 1</ambient><diffuse>0.0 0.8 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- BLUE ZONE - south-west corridor -->
    <model name="zone_blue_sw">
      <static>true</static>
      <pose>-4.5 -3.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3 5 0.01</size></box></geometry>
          <material><ambient>0.0 0.0 0.9 1</ambient><diffuse>0.0 0.0 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- YELLOW ZONE - south center strip -->
    <model name="zone_yellow_sc">
      <static>true</static>
      <pose>-1.5 -4.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3 3 0.01</size></box></geometry>
          <material><ambient>0.9 0.9 0.0 1</ambient><diffuse>0.9 0.9 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
